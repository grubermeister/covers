# nginx site for the WorldCovers staging/demo box (e.g. woco.dev).
#
# deploy/provision.sh renders this template (substituting __HOSTNAME__ and
# __ROOT__) into /etc/nginx/sites-available/woco. It is HTTP-only on purpose:
# `certbot --nginx -d <hostname>` rewrites this file in place to add the TLS
# (443) server block and the 80->443 redirect once DNS resolves. Do not add a
# ssl_certificate path here by hand -- the cert does not exist until certbot
# runs, and nginx will refuse to start if it points at a missing file.
#
# gunicorn listens on 127.0.0.1:8000 (see deploy/worldcovers.service). Django
# trusts X-Forwarded-Proto for its HTTPS detection (SECURE_PROXY_SSL_HEADER in
# backend/woco/settings.py), so it must be forwarded.

server {
    listen 80;
    listen [::]:80;
    server_name __HOSTNAME__ www.__HOSTNAME__;

    # Cover-image uploads from the submission flow.
    # Matches the UI and Django per-file upload limit.
    client_max_body_size 100m;

    # Serve Django static + uploaded media straight from disk; everything else
    # goes to gunicorn. collectstatic writes to backend/static; uploads and
    # imported catalog images live under backend/media/<state>/.
    location /static/ {
        alias __ROOT__/backend/static/;
        access_log off;
        expires 30d;
    }

    location /media/ {
        alias __ROOT__/backend/media/;
        access_log off;
        expires 30d;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
}
