DJANGO_SETTINGS_MODULE=woco.settings
PYTHONPATH=backend
DEBUG=True
DB_NAME=worldcovers
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=WorldCovers <no-reply@hellowoco.app>
DJANGO_APP_HOSTNAME=hellowoco.app

# ASCC pipeline LLM provider. API-dependent stages are:
# tools/ascc_page_processor.py --stages halves,chunks
# tools/ascc_page_extract.py
PIPELINE_LLM_PROVIDER=openrouter
PIPELINE_LLM_MODEL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
